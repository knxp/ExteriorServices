@using ExteriorServices.Web
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ExteriorServices</title>
    <style>
            :root {
                --bg: linear-gradient(135deg, #edf4f7 0%, #ddeaf1 36%, #d8e3eb 100%);
                --surface: rgba(255, 255, 255, 0.8);
                --surface-strong: rgba(248, 250, 252, 0.96);
                --sidebar-bg: #171d24;
                --sidebar-bg-alt: #1f2a33;
                --sidebar-accent: #f2994a;
                --sidebar-accent-strong: #dd7d2d;
                --panel-border: rgba(20, 32, 41, 0.06);
                --line: rgba(118, 137, 149, 0.26);
                --text: #1d2b31;
                --muted: rgba(29, 43, 49, 0.72);
                --blue-slate: #315a70;
                --blue-slate-deep: #234b62;
                --shadow: 0 22px 48px rgba(22, 36, 46, 0.14);
                --radius: 22px;
            }

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                height: 100%;
                overflow-x: hidden;
                background:
                    radial-gradient(circle at top left, rgba(242, 153, 74, 0.10), transparent 28%),
                    radial-gradient(circle at bottom right, rgba(49, 90, 112, 0.16), transparent 24%),
                    var(--bg);
                color: var(--text);
                font-family: "SF Pro Display", "SF Pro Text", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
                line-height: 1.5;
            }

            body {
                min-height: 100dvh;
            }

            main {
                max-width: 1240px;
                margin: 0 auto 0 90px;
                padding: 32px 20px 80px;
                transition: margin-left 0.25s ease, max-width 0.25s ease;
            }

            h1,
            h2,
            h3,
            label,
            th,
            button,
            a {
                font-family: "SF Pro Display", "SF Pro Text", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
            }

            .page-shell {
                display: grid;
                gap: 26px;
                min-width: 0;
            }

            .panel {
                background: var(--surface);
                border: 1px solid var(--panel-border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                padding: 26px 26px 24px;
                backdrop-filter: blur(8px);
                min-width: 0;
                max-width: 100%;
            }

            .page-hero {
                display: grid;
                gap: 12px;
                margin-bottom: 6px;
            }

            .page-hero.compact {
                margin-bottom: 0;
            }

            .title {
                font-size: clamp(2.2rem, 2vw, 3rem);
                margin: 0;
                letter-spacing: -0.06em;
                line-height: 1.05;
            }

            .subtitle {
                margin: 0;
                color: var(--muted);
                font-size: 1rem;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                width: fit-content;
                padding: 9px 14px;
                border-radius: 999px;
                background: linear-gradient(135deg, var(--sidebar-accent) 0%, var(--sidebar-accent-strong) 100%);
                color: #fff;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                box-shadow: 0 10px 24px rgba(242, 153, 74, 0.24);
            }

            .banner {
                display: flex;
                align-items: center;
                gap: 10px;
                background: linear-gradient(180deg, rgba(242, 153, 74, 0.12) 0%, rgba(49, 90, 112, 0.08) 100%);
                color: var(--blue-slate-deep);
                border: 1px solid rgba(242, 153, 74, 0.22);
                border-radius: 14px;
                padding: 12px 16px;
                font-size: 14px;
                font-weight: 600;
                margin-top: 18px;
            }

            .banner-dot {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: linear-gradient(180deg, var(--sidebar-accent) 0%, var(--sidebar-accent-strong) 100%);
                box-shadow: 0 0 0 5px rgba(242, 153, 74, 0.13);
            }

            .hero-actions {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 18px;
            }

            .grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .field-stack {
                display: grid;
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .field-item {
                display: grid;
                gap: 8px;
            }

            label {
                display: block;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.02em;
                margin: 0;
                color: var(--text);
                text-align: left;
            }

            input,
            select,
            textarea {
                width: 100%;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.96);
                padding: 12px 14px;
                font-size: 15px;
                color: var(--text);
                transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
            }

            input:focus,
            select:focus,
            textarea:focus {
                outline: none;
                border-color: rgba(242, 153, 74, 0.9);
                box-shadow: 0 0 0 4px rgba(242, 153, 74, 0.13);
                transform: translateY(-1px);
            }

            input[readonly] {
                background: rgba(230, 237, 241, 0.7);
                color: var(--muted);
                cursor: not-allowed;
            }

            textarea {
                resize: vertical;
                min-height: 90px;
            }

            .searchable-select-wrapper {
                position: relative;
            }

            .searchable-select-native {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                opacity: 0;
                pointer-events: none;
            }

            .searchable-select-list {
                position: absolute;
                z-index: 20;
                top: calc(100% + 6px);
                left: 0;
                right: 0;
                max-height: 240px;
                overflow-y: auto;
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 12px;
                box-shadow: 0 16px 32px rgba(22, 36, 46, 0.16);
                padding: 6px;
            }

            .searchable-select-list[hidden] {
                display: none;
            }

            .searchable-select-option {
                display: block;
                width: 100%;
                text-align: left;
                background: transparent;
                color: var(--text);
                font-weight: 500;
                border-radius: 8px;
                padding: 9px 10px;
                box-shadow: none;
            }

            .searchable-select-option:hover,
            .searchable-select-option.active {
                background: rgba(242, 153, 74, 0.12);
            }

            .searchable-select-empty {
                padding: 9px 10px;
                color: var(--muted);
                font-size: 13px;
            }

            button {
                border: none;
                border-radius: 12px;
                background: linear-gradient(180deg, var(--blue-slate-deep) 0%, var(--blue-slate) 100%);
                color: #fff;
                padding: 12px 18px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 12px 24px rgba(33, 68, 87, 0.22);
            }

            button:hover {
                filter: brightness(1.04);
            }

            .primary-action-link,
            .secondary-action-link,
            .mode-link,
            .segment-option,
            .home-link,
            .nav-item {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                padding: 11px 16px;
                text-decoration: none;
                font-size: 14px;
                font-weight: 700;
                transition: all 0.2s ease;
            }

            .primary-action-link {
                background: linear-gradient(180deg, var(--blue-slate-deep) 0%, var(--blue-slate) 100%);
                color: #fff;
                box-shadow: 0 12px 24px rgba(33, 68, 87, 0.22);
            }

            .secondary-action-link {
                background: rgba(255, 255, 255, 0.9);
                border: 1px solid var(--line);
                color: var(--text);
            }

            .mode-switch,
            .segment-switch {
                display: inline-flex;
                gap: 6px;
                padding: 6px;
                background: rgba(230, 237, 241, 0.96);
                border: 1px solid rgba(130, 149, 160, 0.24);
                border-radius: 999px;
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
            }

            .mode-link,
            .segment-option {
                background: transparent;
                color: var(--muted);
                border: 0;
                min-width: 120px;
                border-radius: 999px;
                padding: 10px 16px;
                box-shadow: none;
            }

            .mode-link.active,
            .segment-option.active {
                background: linear-gradient(180deg, var(--blue-slate-deep) 0%, var(--blue-slate) 100%);
                color: #fff;
                box-shadow: 0 10px 18px rgba(31, 61, 76, 0.18);
            }

            .top-form-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
                margin-bottom: 18px;
            }

            .section-title {
                margin: 0 0 18px;
                font-size: 1.25rem;
                letter-spacing: -0.03em;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                border-spacing: 0;
                background: rgba(255, 255, 255, 0.72);
                border-radius: 16px;
                overflow: hidden;
            }

            th,
            td {
                padding: 16px 14px;
                border-bottom: 1px solid var(--line);
                text-align: left;
                vertical-align: top;
            }

            th {
                background: var(--surface-strong);
                font-size: 11px;
                letter-spacing: 0.09em;
                text-transform: uppercase;
                color: var(--muted);
                font-weight: 700;
            }

            tbody tr:hover {
                background: rgba(242, 153, 74, 0.04);
            }

            ul {
                margin: 0;
                padding-left: 18px;
            }

            .empty-state {
                color: var(--muted);
                margin: 0;
                padding: 8px 0 0;
            }

            .button-row {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
                margin-top: 24px;
            }

            .section-block {
                display: grid;
                gap: 16px;
                padding-top: 8px;
            }

            .upload-surface {
                display: grid;
                justify-items: center;
                gap: 8px;
                padding: 34px 20px;
                border: 1px dashed rgba(49, 90, 112, 0.42);
                border-radius: 16px;
                background: rgba(235, 243, 246, 0.58);
                color: var(--blue-slate-deep);
                text-align: center;
                cursor: pointer;
                transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
            }

            .upload-surface:hover,
            .upload-surface:focus-within {
                border-color: var(--sidebar-accent);
                background: rgba(242, 153, 74, 0.08);
                transform: translateY(-1px);
            }

            .upload-icon {
                display: grid;
                place-items: center;
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: var(--blue-slate-deep);
                color: #fff;
                font-size: 25px;
                line-height: 1;
            }

            .upload-title {
                font-weight: 800;
            }

            .upload-copy,
            .modifier-heading span {
                color: var(--muted);
                font-size: 13px;
            }

            .modifier-list {
                display: grid;
                gap: 14px;
            }

            .design-notes {
                display: grid;
                gap: 8px;
                margin-top: 20px;
                margin-bottom: 20px;
            }

            .modifier-group {
                display: grid;
                gap: 0;
                overflow: hidden;
                border: 1px solid var(--line);
                border-radius: 16px;
                background: rgba(255, 255, 255, 0.58);
            }

            .modifier-heading,
            .modifier-option {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                min-height: 54px;
                padding: 12px 16px;
            }

            .modifier-heading {
                background: rgba(230, 237, 241, 0.7);
            }

            .modifier-heading>div {
                display: grid;
                gap: 2px;
            }

            .modifier-option {
                border-top: 1px solid var(--line);
                cursor: pointer;
                font-size: 14px;
            }

            .modifier-option-controls {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                flex-shrink: 0;
            }

            .modifier-color {
                width: auto;
                min-width: 108px;
                padding: 7px 28px 7px 9px;
                border-radius: 9px;
                font-size: 12px;
            }

            .modifier-option input,
            .toggle input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .checkmark {
                width: 20px;
                height: 20px;
                flex-shrink: 0;
                border: 1px solid rgba(49, 90, 112, 0.35);
                border-radius: 6px;
                background: #fff;
            }

            .modifier-option input:checked+.checkmark {
                border-color: var(--blue-slate-deep);
                background: var(--blue-slate-deep);
                box-shadow: inset 0 0 0 4px #fff;
            }

            .toggle {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: var(--muted);
                cursor: pointer;
                font-size: 12px;
                text-transform: uppercase;
            }

            .toggle>span {
                position: relative;
                width: 38px;
                height: 22px;
                border-radius: 999px;
                background: rgba(118, 137, 149, 0.32);
                transition: background 0.2s ease;
            }

            .toggle>span::after {
                position: absolute;
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #fff;
                content: "";
                transition: transform 0.2s ease;
            }

            .toggle input:checked+span {
                background: var(--sidebar-accent);
            }

            .toggle input:checked+span::after {
                transform: translateX(16px);
            }

            .generate-action {
                width: 100%;
                min-height: 56px;
                margin-top: 0;
                background: linear-gradient(180deg, var(--sidebar-accent) 0%, var(--sidebar-accent-strong) 100%);
                font-size: 16px;
                letter-spacing: 0.01em;
                transition: filter 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
            }

            .generate-action:not(:disabled):hover {
                filter: brightness(1.05);
                transform: translateY(-1px);
            }

            .image-library-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 16px;
            }

            .image-library-card {
                overflow: hidden;
                border: 1px solid var(--panel-border);
                border-radius: 16px;
                background: rgba(255, 255, 255, 0.8);
                box-shadow: 0 12px 28px rgba(22, 36, 46, 0.1);
            }

            .image-library-card img {
                display: block;
                width: 100%;
                aspect-ratio: 4 / 3;
                object-fit: cover;
                background: rgba(230, 237, 241, 0.9);
                cursor: zoom-in;
            }

            .image-library-card-photos {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1px;
                background: var(--panel-border);
            }

            .image-library-card-photos:has(img:only-child) {
                grid-template-columns: 1fr;
            }

            .image-lightbox {
                position: fixed;
                inset: 0;
                z-index: 1000;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 32px;
                background: rgba(15, 22, 28, 0.86);
                cursor: zoom-out;
            }

            .image-lightbox[hidden] {
                display: none;
            }

            .image-lightbox img {
                max-width: 100%;
                max-height: 100%;
                border-radius: 12px;
                box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
            }

            .image-lightbox-close {
                position: absolute;
                top: 22px;
                right: 26px;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.14);
                color: #fff;
                font-size: 20px;
                line-height: 1;
                box-shadow: none;
            }

            .image-lightbox-close:hover {
                background: rgba(255, 255, 255, 0.24);
            }

            .calendar-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 18px;
            }

            .calendar-title {
                margin: 0;
                text-align: center;
                flex: 1;
            }

            .calendar-weekdays {
                display: grid;
                grid-template-columns: repeat(7, 1fr);
                gap: 8px;
                margin-bottom: 8px;
                color: var(--muted);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                text-align: center;
            }

            .calendar-grid {
                display: grid;
                grid-template-columns: repeat(7, 1fr);
                gap: 8px;
            }

            .calendar-day {
                min-height: 96px;
                border: 1px solid var(--panel-border);
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.7);
                padding: 8px;
                display: grid;
                align-content: start;
                gap: 4px;
            }

            .calendar-day-empty {
                background: transparent;
                border-color: transparent;
            }

            .calendar-day-today {
                border-color: var(--sidebar-accent);
                box-shadow: 0 0 0 2px rgba(242, 153, 74, 0.18);
            }

            .calendar-day-number {
                font-size: 12px;
                font-weight: 700;
                color: var(--muted);
            }

            .calendar-job-chip {
                display: block;
                width: 100%;
                text-align: left;
                background: linear-gradient(180deg, var(--blue-slate-deep) 0%, var(--blue-slate) 100%);
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                padding: 5px 8px;
                border-radius: 8px;
                box-shadow: none;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .calendar-job-chip:hover {
                filter: brightness(1.08);
            }

            .calendar-job-chip-teardown {
                background: linear-gradient(180deg, var(--sidebar-accent) 0%, var(--sidebar-accent-strong) 100%);
            }

            .job-detail-card {
                display: grid;
                gap: 10px;
                max-width: 420px;
                width: 100%;
                cursor: default;
            }

            .job-detail-card ul {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                gap: 6px;
                font-size: 14px;
            }

            @@media (max-width: 720px) {
                .calendar-weekdays span:nth-child(n) {
                    font-size: 10px;
                }

                .calendar-day {
                    min-height: 72px;
                    padding: 6px;
                }

                .calendar-job-chip {
                    font-size: 10px;
                }
            }

            .add-job-panel {
                padding: 0;
            }

            .add-job-panel>form {
                padding: 0 26px 24px;
            }

            .add-job-summary {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 26px 26px 24px;
                margin: 0;
                cursor: pointer;
                font-size: 1.25rem;
                font-weight: 700;
                letter-spacing: -0.03em;
                list-style: none;
            }

            .add-job-summary::-webkit-details-marker {
                display: none;
            }

            .add-job-caret {
                transition: transform 0.2s ease;
                color: var(--muted);
                font-size: 20px;
            }

            .add-job-panel[open] .add-job-summary {
                padding-bottom: 8px;
            }

            .add-job-panel[open] .add-job-caret {
                transform: rotate(180deg);
            }

            .image-library-card-body {
                display: grid;
                gap: 2px;
                padding: 12px 14px 14px;
                color: var(--muted);
                font-size: 12px;
            }

            .image-library-card-body strong {
                color: var(--text);
                font-size: 14px;
            }

            .image-library-empty {
                display: grid;
                gap: 18px;
            }

            .image-library-loading {
                display: flex;
                align-items: center;
                gap: 10px;
                min-height: 72px;
                color: var(--muted);
            }

            .loading-spinner {
                width: 20px;
                height: 20px;
                border: 3px solid rgba(49, 90, 112, 0.2);
                border-top-color: var(--sidebar-accent);
                border-radius: 50%;
                animation: image-library-spin 0.8s linear infinite;
            }

            .image-library-grid[hidden],
            .image-library-loading[hidden],
            .image-library-empty[hidden] {
                display: none;
            }

            @@keyframes image-library-spin {
                to {
                    transform: rotate(360deg);
                }
            }

            .result-preview {
                display: block;
                width: 100%;
                padding: 0;
                overflow: hidden;
                border: 1px solid var(--line);
                background: rgba(230, 237, 241, 0.7);
                cursor: zoom-in;
            }

            .result-preview img {
                display: block;
                width: 100%;
                max-height: 520px;
                object-fit: contain;
            }

            button:disabled {
                cursor: not-allowed;
                opacity: 0.52;
                box-shadow: none;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 78px;
                background: linear-gradient(180deg, var(--sidebar-bg) 0%, var(--sidebar-bg-alt) 100%);
                border: 0;
                border-right: 1px solid rgba(255, 255, 255, 0.06);
                border-radius: 0;
                box-shadow: 0 20px 40px rgba(17, 25, 32, 0.34);
                transition: width 0.25s ease;
                z-index: 50;
                overflow: hidden;
            }

            .sidebar.open {
                width: 250px;
            }

            .nav-trigger {
                width: 100%;
                background: transparent;
                border: 0;
                border-radius: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 7px;
                padding: 18px 14px 16px;
                cursor: pointer;
                box-shadow: none;
            }

            .nav-trigger span {
                display: block;
                width: 24px;
                height: 3px;
                background: rgba(255, 255, 255, 0.9);
                border-radius: 999px;
            }

            .nav-trigger:hover {
                background: rgba(255, 255, 255, 0.04);
            }

            .sidebar-menu {
                display: grid;
                gap: 8px;
                margin-top: 18px;
                padding: 0 12px 18px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0;
                width: 100%;
                padding: 12px 0;
                border-radius: 14px;
                color: rgba(255, 255, 255, 0.8);
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid rgba(255, 255, 255, 0.04);
                font-size: 13px;
                letter-spacing: 0.02em;
                text-decoration: none;
                transition: all 0.2s ease;
            }

            .sidebar.open .nav-item {
                justify-content: flex-start;
                gap: 12px;
                padding: 12px 14px;
            }

            .nav-item .nav-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 24px;
                font-size: 16px;
                flex-shrink: 0;
            }

            .nav-item .nav-label {
                display: none;
                opacity: 0;
                white-space: nowrap;
                transition: opacity 0.2s ease 0.1s;
            }

            .sidebar.open .nav-item .nav-label {
                display: inline-block;
                opacity: 1;
            }

            .nav-item:hover {
                background: rgba(242, 153, 74, 0.12);
                border-color: rgba(242, 153, 74, 0.22);
                color: #fff;
                transform: translateX(-1px);
            }

            .nav-item.active {
                background: linear-gradient(135deg, rgba(242, 153, 74, 0.22) 0%, rgba(221, 125, 45, 0.22) 100%);
                border-color: rgba(242, 153, 74, 0.42);
                color: #fff;
            }

            .sidebar.open~main {
                margin-left: 170px;
            }

            @@media (max-width: 640px) {
                .sidebar {
                    top: 0;
                    right: auto;
                    bottom: 0;
                    left: 0;
                    width: 64px;
                    z-index: 100;
                }

                .sidebar.open {
                    width: 220px;
                }

                .sidebar-menu {
                    padding: 0 10px 14px;
                }

                main {
                    margin-left: 64px;
                    margin-right: 0;
                    width: calc(100% - 64px);
                    max-width: none;
                    padding: 20px 14px 100px;
                }

                .sidebar.open~main {
                    margin-left: 64px;
                }

                .panel {
                    padding: 18px;
                }

                .title {
                    font-size: 2rem;
                }

                .subtitle {
                    font-size: 0.95rem;
                }

                .top-form-header {
                    align-items: flex-start;
                }

                .field-item,
                .field-item input,
                .field-item select,
                .field-item textarea {
                    min-width: 0;
                }

                .modifier-heading,
                .modifier-option {
                    padding: 11px 12px;
                }

                .modifier-heading {
                    align-items: flex-start;
                }

                .modifier-heading>div {
                    min-width: 0;
                }

                .modifier-option-controls {
                    gap: 7px;
                    max-width: 100%;
                }

                .modifier-color {
                    min-width: 96px;
                    max-width: 96px;
                    padding-left: 7px;
                    padding-right: 20px;
                }

                .modifier-heading strong,
                .modifier-heading span,
                .modifier-option>span:first-child {
                    min-width: 0;
                    overflow-wrap: anywhere;
                }

                .upload-surface {
                    min-height: 150px;
                    padding: 26px 14px;
                }

                th,
                td {
                    padding: 12px 10px;
                }
            }
    </style>
</head>

<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
    }

    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
        <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="sidebar-menu"
                aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="sidebar-menu" id="sidebar-menu" aria-label="Sidebar menu">
            <a class="nav-item @(currentPath == AppRoutes.Home ? "active" : "")" href="@AppRoutes.Home">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Home</span>
            </a>
            <a class="nav-item @(currentPath.StartsWith(AppRoutes.AddCustomer, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@AppRoutes.AddCustomerWithMode(AppRoutes.ModeAdd)">
                <span class="nav-icon">＋</span>
                <span class="nav-label">Add Customer</span>
            </a>
            <a class="nav-item @(currentPath.StartsWith(AppRoutes.Records, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@AppRoutes.Records">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Customer Records</span>
            </a>
            <a class="nav-item @(currentPath.StartsWith(AppRoutes.Generate, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@AppRoutes.Generate">
                <span class="nav-icon">📷</span>
                <span class="nav-label">Generate Preview</span>
            </a>
            <a class="nav-item @(currentPath.StartsWith(AppRoutes.Images, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@AppRoutes.Images">
                <span class="nav-icon">🖼️</span>
                <span class="nav-label">Images</span>
            </a>
            <a class="nav-item @(currentPath.StartsWith(AppRoutes.Calendar, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@AppRoutes.Calendar">
                <span class="nav-icon">📅</span>
                <span class="nav-label">Calendar</span>
            </a>
        </nav>
    </aside>

    <main role="main">
        <div class="page-shell">
            @RenderBody()
        </div>
    </main>

    <script>
            const sidebar = document.getElementById('sidebar');
            const navTrigger = sidebar?.querySelector('.nav-trigger');

            function setOpen(isOpen) {
                sidebar.classList.toggle('open', isOpen);
                navTrigger?.setAttribute('aria-expanded', String(isOpen));
            }

            if (navTrigger) {
                navTrigger.addEventListener('click', () => {
                    setOpen(!sidebar.classList.contains('open'));
                });
            }

            sidebar?.addEventListener('click', (event) => {
                if (event.target.closest('.nav-trigger') || event.target.closest('.nav-item')) {
                    return;
                }
                if (!sidebar.classList.contains('open')) {
                    setOpen(true);
                }
            });

            document.addEventListener('click', (event) => {
                if (sidebar?.classList.contains('open') && !sidebar.contains(event.target)) {
                    setOpen(false);
                }
            });

            function enhanceSearchableSelect(select) {
                if (select.dataset.searchEnhanced) {
                    return;
                }
                select.dataset.searchEnhanced = 'true';

                const wrapper = document.createElement('div');
                wrapper.className = 'searchable-select-wrapper';
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);
                select.classList.add('searchable-select-native');

                const input = document.createElement('input');
                input.type = 'text';
                input.autocomplete = 'off';
                input.placeholder = select.dataset.placeholder || 'Search by name...';
                wrapper.appendChild(input);

                const list = document.createElement('div');
                list.className = 'searchable-select-list';
                list.hidden = true;
                wrapper.appendChild(list);

                const options = Array.from(select.options)
                    .filter(option => option.value !== '')
                    .map(option => ({ value: option.value, label: option.textContent.trim() }));

                function syncInputFromSelect() {
                    const selected = select.options[select.selectedIndex];
                    input.value = selected && selected.value !== '' ? selected.textContent.trim() : '';
                }

                function renderList(term) {
                    const query = term.trim().toLowerCase();
                    const matches = options.filter(option => option.label.toLowerCase().includes(query));
                    list.replaceChildren();

                    if (matches.length === 0) {
                        const empty = document.createElement('div');
                        empty.className = 'searchable-select-empty';
                        empty.textContent = 'No matching customers';
                        list.appendChild(empty);
                        return;
                    }

                    matches.forEach(option => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'searchable-select-option';
                        item.textContent = option.label; item.addEventListener('click', () => {
                            select.value = option.value;
                            input.value = option.label;
                            list.hidden = true;
                            select.dispatchEvent(new Event('change', { bubbles: true }));
                        }); list.appendChild(item);
                    });
                }

                input.addEventListener('focus', () => {
                    renderList('');
                    list.hidden = false;
                });
                input.addEventListener('input', () => {
                    renderList(input.value);
                    list.hidden = false;
                });
                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') {
                        list.hidden = true;
                        syncInputFromSelect();
                    }
                });

                document.addEventListener('click', (event) => {
                    if (!wrapper.contains(event.target)) {
                        list.hidden = true;
                        syncInputFromSelect();
                    }
                });

                syncInputFromSelect();
            }

            document.querySelectorAll('select.searchable-select').forEach(enhanceSearchableSelect);
    </script>
</body>

</html>
