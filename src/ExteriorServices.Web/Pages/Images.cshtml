@page "/admin/images"
@model ExteriorServices.Web.Pages.ImagesModel

<div class="panel">
    <div class="page-hero">
        <div class="eyebrow">Image Library</div>
        <h1 class="title">Images</h1>
        <p class="subtitle">Uploaded property photos and generated previews will appear here.</p>
    </div>
</div>

<div class="image-library-loading" id="image-library-loading" role="status" aria-live="polite">
    <span class="loading-spinner" aria-hidden="true"></span>
    <span>Loading images...</span>
</div>

<div class="image-library-grid" id="image-library-grid" hidden></div>

<div class="panel image-library-empty" id="image-library-empty" hidden>
    <p class="empty-state">No images have been uploaded yet.</p>
    <a class="secondary-action-link" href="@AppRoutes.Generate">Open Generate</a>
</div>

<p class="empty-state" id="image-library-error" role="alert" hidden>
    Images could not be loaded. Try refreshing the page.
</p>

<div class="image-lightbox" id="image-lightbox" hidden>
    <button class="image-lightbox-close" id="image-lightbox-close" type="button" aria-label="Close">&times;</button>
    <img id="image-lightbox-image" alt="Full screen property photo" />
</div>

<script>
    const imageLibraryLoading = document.getElementById('image-library-loading');
    const imageLibraryGrid = document.getElementById('image-library-grid');
    const imageLibraryEmpty = document.getElementById('image-library-empty');
    const imageLibraryError = document.getElementById('image-library-error');
    const imageApiBaseUrl = '@Model.BrowserApiBaseUrl'.replace(/\/$/, '');
    const imageLightbox = document.getElementById('image-lightbox');
    const imageLightboxImage = document.getElementById('image-lightbox-image');
    const imageLightboxClose = document.getElementById('image-lightbox-close');

    function openLightbox(src) {
        imageLightboxImage.src = src;
        imageLightbox.hidden = false;
    }

    function closeLightbox() {
        imageLightbox.hidden = true;
        imageLightboxImage.src = '';
    }

    imageLightbox.addEventListener('click', closeLightbox);
    imageLightboxClose.addEventListener('click', (event) => {
        event.stopPropagation();
        closeLightbox();
    });
    imageLightboxImage.addEventListener('click', (event) => event.stopPropagation());
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !imageLightbox.hidden) {
            closeLightbox();
        }
    });

    function showLibraryState(state) {
        imageLibraryLoading.hidden = state !== 'loading';
        imageLibraryGrid.hidden = state !== 'images';
        imageLibraryEmpty.hidden = state !== 'empty';
        imageLibraryError.hidden = state !== 'error';
    }

    function renderImages(images) {
        imageLibraryGrid.replaceChildren();

        images.forEach(image => {
            const card = document.createElement('article');
            card.className = 'image-library-card';

            const photos = document.createElement('div');
            photos.className = 'image-library-card-photos';

            const preview = document.createElement('img');
            const sourceUrl = image.sourceUrl ?? image.SourceUrl;
            const fullSrc = `${imageApiBaseUrl}${sourceUrl}`;
            preview.src = fullSrc;
            preview.alt = 'Uploaded property photo';
            preview.loading = 'lazy';
            preview.addEventListener('click', () => openLightbox(fullSrc));
            photos.append(preview);

            const resultUrl = image.resultUrl ?? image.ResultUrl;
            if (resultUrl) {
                const resultImg = document.createElement('img');
                const fullResultSrc = `${imageApiBaseUrl}${resultUrl}`;
                resultImg.src = fullResultSrc;
                resultImg.alt = 'AI-generated property preview';
                resultImg.loading = 'lazy';
                resultImg.addEventListener('click', () => openLightbox(fullResultSrc));
                photos.append(resultImg);
            }

            const details = document.createElement('div');
            details.className = 'image-library-card-body';

            const id = document.createElement('strong');
            const intakeId = image.intakeId ?? image.IntakeId ?? '';
            id.textContent = intakeId.replaceAll('-', '').slice(0, 8);
            const date = document.createElement('span');
            date.textContent = new Date(image.createdAtUtc ?? image.CreatedAtUtc).toLocaleString();
            const size = document.createElement('span');
            size.textContent = `${Math.round((image.size ?? image.Size ?? 0) / 1024)} KB`;

            details.append(id, date, size);
            card.append(photos, details);
            imageLibraryGrid.append(card);
        });
    }

    async function loadImages() {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 10000);

        try {
            const response = await fetch(`${imageApiBaseUrl}/api/property-visualizations`, {
                signal: controller.signal
            });
            if (!response.ok) throw new Error('Image request failed');

            const images = await response.json();
            renderImages(Array.isArray(images) ? images : []);
            showLibraryState(images.length ? 'images' : 'empty');
        } catch {
            showLibraryState('error');
        } finally {
            clearTimeout(timeout);
        }
    }

    loadImages();
</script>
